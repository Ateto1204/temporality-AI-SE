+    @Test
+    fun `cookie setting bytecode avoids Java 21 List removeFirst`() {
+        // A removeFirst call can link to java.util.List.removeFirst when compiled on newer JDKs.
+        val cookieHelpers = requireNotNull(Cookie::class.java.classLoader.getResourceAsStream("io/javalin/http/CookieKt.class")) {
+            "Cookie helpers class not found"
+        }.use { it.readBytes().toString(Charsets.ISO_8859_1) }
+
+        assertThat(cookieHelpers).doesNotContain("removeFirst")
+    }
+
     @Test
     fun `setting a Cookie object works`() = TestUtil.test { app, http ->
         app.get("/create-cookie") { it.cookie(Cookie("Hest", "Hast", maxAge = 7)) }
