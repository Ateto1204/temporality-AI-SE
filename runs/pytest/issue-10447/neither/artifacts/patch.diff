+    def _getusefixturesnames(self, node: nodes.Node, cls) -> Tuple[str, ...]:
+        """Return usefixtures names for a node.
+
+        unittest.TestCase subclasses need class inheritance to preserve parent
+        class fixtures before subclass fixtures.
+        """
+        if not getattr(node, "nofuncargs", False) or cls is None or node.parent is None:
+            return tuple(
+                arg for mark in node.iter_markers(name="usefixtures") for arg in mark.args
+            )
+
+        function_usefixtures: List[str] = []
+        outer_usefixtures: List[str] = []
+        class_markers_present = False
+        class_node = node.parent
+
+        for mark_node, mark in node.iter_markers_with_node(name="usefixtures"):
+            if mark_node is class_node:
+                class_markers_present = True
+                continue
+            if class_markers_present:
+                outer_usefixtures.extend(mark.args)
+            else:
+                function_usefixtures.extend(mark.args)
+
+        if not class_markers_present:
+            return tuple(function_usefixtures + outer_usefixtures)
+
+        class_usefixtures: List[str] = []
+        for base in reversed(cls.__mro__):
+            for mark in get_unpacked_marks(base, consider_mro=False):
+                if mark.name == "usefixtures":
+                    class_usefixtures.extend(mark.args)
+
+        return tuple(function_usefixtures + class_usefixtures + outer_usefixtures)
+
