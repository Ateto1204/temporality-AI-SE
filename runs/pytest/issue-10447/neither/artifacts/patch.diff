+def test_usefixtures_marker_on_unittest_inheritance(pytester: Pytester) -> None:
+    pytester.makepyfile(
+        """
+        import unittest
+        import pytest
+
+        events = []
+
+        @pytest.fixture(scope="class")
+        def parent_fix():
+            events.append("parent")
+
+        @pytest.fixture(scope="class")
+        def child_fix():
+            assert events == ["parent"]
+            events.append("child")
+
+        @pytest.mark.usefixtures("parent_fix")
+        class Base(unittest.TestCase):
+            pass
+
+        @pytest.mark.usefixtures("child_fix")
+        class Child(Base):
+            def test_child(self):
+                assert events == ["parent", "child"]
+        """
+    )
+
+    result = pytester.runpytest()
+    result.assert_outcomes(passed=1)
+
