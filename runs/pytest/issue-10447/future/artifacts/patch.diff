+    def _getusefixtures(self, node: nodes.Node) -> Tuple[str, ...]:
+        usefixtures = []
+        for chain_node in node.listchain():
+            obj = getattr(chain_node, "obj", None)
+            if inspect.isclass(obj):
+                for base in reversed(obj.__mro__):
+                    for mark in get_unpacked_marks(base, consider_mro=False):
+                        if mark.name == "usefixtures":
+                            usefixtures.extend(mark.args)
+            else:
+                for mark in chain_node.own_markers:
+                    if mark.name == "usefixtures":
+                        usefixtures.extend(mark.args)
+        return tuple(usefixtures)
