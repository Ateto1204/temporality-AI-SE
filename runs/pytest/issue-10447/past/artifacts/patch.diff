+    def _getusefixturesmarks(self, node: nodes.Node) -> Iterator[Mark]:
+        """Yield usefixtures marks for a node.
+
+        For classes, inherited class marks are yielded base-first so class-level
+        fixtures run in the order users expect when subclassing test classes.
+        """
+        for current in reversed(node.listchain()):
+            if isinstance(getattr(current, "obj", None), type):
+                usefixtures_marks = []
+                for cls in current.obj.__mro__[1:]:
+                    if cls is object:
+                        continue
+                    usefixtures_marks.extend(
+                        mark
+                        for mark in get_unpacked_marks(cls, consider_mro=False)
+                        if mark.name == "usefixtures"
+                    )
+                usefixtures_marks.extend(
+                    mark
+                    for mark in get_unpacked_marks(current.obj, consider_mro=False)
+                    if mark.name == "usefixtures"
+                )
+                yield from usefixtures_marks
+                yield from (
+                    mark
+                    for mark in getattr(current, "own_markers", ())
+                    if mark.name == "usefixtures" and mark not in usefixtures_marks
+                )
+            else:
+                yield from (
+                    mark
+                    for mark in getattr(current, "own_markers", ())
+                    if mark.name == "usefixtures"
+                )
+
