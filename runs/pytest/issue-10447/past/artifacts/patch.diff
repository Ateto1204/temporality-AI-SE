+def test_usefixtures_marker_inherited_from_unittest_base(pytester: Pytester) -> None:
+    pytester.makepyfile(
+        """
+        import unittest
+        import pytest
+
+        order = []
+
+        @pytest.fixture(scope="class")
+        def parent_fixture(request):
+            order.append("parent")
+            request.cls.parent_ready = True
+
+        @pytest.fixture(scope="class")
+        def child_fixture(request):
+            order.append("child")
+            assert request.cls.parent_ready
+
+        @pytest.mark.usefixtures("parent_fixture")
+        class Base(unittest.TestCase):
+            pass
+
+        @pytest.mark.usefixtures("child_fixture")
+        class Test(Base):
+            def test_one(self):
+                assert self.parent_ready
+                assert order == ["parent", "child"]
+        """
+    )
+    result = pytester.runpytest()
+    result.assert_outcomes(passed=1)
+
