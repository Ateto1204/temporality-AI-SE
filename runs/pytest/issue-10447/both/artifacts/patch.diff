+def test_usefixtures_marker_on_unittest_subclass(pytester: Pytester) -> None:
+    pytester.makepyfile(
+        """
+        import pytest
+        import unittest
+
+        @pytest.fixture
+        def base_fixture(request):
+            request.instance.base_fixture_ready = True
+
+        @pytest.fixture
+        def subclass_fixture(request):
+            assert request.instance.base_fixture_ready
+            request.instance.subclass_fixture_ready = True
+
+        @pytest.mark.usefixtures("base_fixture")
+        class Base(unittest.TestCase):
+            base_fixture_ready = False
+            subclass_fixture_ready = False
+
+        @pytest.mark.usefixtures("subclass_fixture")
+        class TestSubclass(Base):
+            def test_usefixtures_order(self):
+                assert self.subclass_fixture_ready
+        """
+    )
+
+    result = pytester.runpytest(
+        "-W", "ignore:TestResult has no addDuration method:RuntimeWarning"
+    )
+    result.assert_outcomes(passed=1)
