+def _iter_usefixtures_from_class(cls: type, markers: Iterable[Mark]) -> Iterator[str]:
+    """Return usefixtures names for a class, keeping base classes first."""
+    seen: Set[int] = set()
+    for basecls in reversed(cls.__mro__):
+        for mark in get_unpacked_marks(basecls, consider_mro=False):
+            if mark.name == "usefixtures":
+                seen.add(id(mark))
+                yield from cast(Sequence[str], mark.args)
+
+    for mark in markers:
+        if mark.name == "usefixtures" and id(mark) not in seen:
+            yield from cast(Sequence[str], mark.args)
+
+
+def _iter_usefixtures_names(node: nodes.Node) -> Iterator[str]:
+    """Return fixture names from usefixtures markers applicable to node."""
+    processed_class_nodes: Set[nodes.Node] = set()
+    for mark_node, mark in node.iter_markers_with_node(name="usefixtures"):
+        cls = safe_getattr(mark_node, "obj", None)
+        if isinstance(cls, type):
+            if mark_node in processed_class_nodes:
+                continue
+            processed_class_nodes.add(mark_node)
+            yield from _iter_usefixtures_from_class(cls, mark_node.own_markers)
+        else:
+            yield from cast(Sequence[str], mark.args)
+
